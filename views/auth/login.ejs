<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход | Система контроля ключей МТС</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @font-face {
            font-family: 'MTSWide';
            src: url('/fonts/Wide/MTSWide-Bold.otf') format('opentype');
            font-weight: 700;
        }
        @font-face {
            font-family: 'MTSCompact';
            src: url('/fonts/Compact/MTSCompact-Regular.otf') format('opentype');
            font-weight: 400;
        }
        @font-face {
            font-family: 'MTSCompact';
            src: url('/fonts/Compact/MTSCompact-Medium.otf') format('opentype');
            font-weight: 500;
        }
        @font-face {
            font-family: 'MTSText';
            src: url('/fonts/Text/MTSText-Regular.otf') format('opentype');
            font-weight: 400;
        }

        :root {
            --color-brand-mts-red: #ff0032;
            --color-text-primary: #1d2023;
            --color-background-primary: #ffffff;
            --color-background-secondary: #f2f3f7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'MTSText', 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: var(--color-background-primary);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .mts-logo-large {
            text-align: center;
            margin-bottom: 20px;
        }

        .mts-logo-large img {
            height: 50px;
            width: auto;
        }

        .login-card h2 {
            font-family: 'MTSWide', sans-serif;
            font-weight: 700;
            font-size: 24px;
            text-align: center;
            margin-bottom: 10px;
            color: var(--color-text-primary);
        }

        .login-card .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .btn-login {
            background: var(--color-brand-mts-red);
            border: none;
            color: white;
            padding: 12px;
            font-weight: 600;
            font-family: 'MTSCompact', sans-serif;
            border-radius: 8px;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-login:hover {
            background: #cc0028;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 0, 50, 0.3);
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #d0d5dd;
            padding: 10px 14px;
            font-family: 'MTSText', sans-serif;
        }

        .form-control:focus {
            border-color: var(--color-brand-mts-red);
            outline: none;
            box-shadow: 0 0 0 3px rgba(255, 0, 50, 0.1);
        }

        .form-label {
            font-family: 'MTSCompact', sans-serif;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-text {
            font-size: 12px;
            color: #6c757d;
        }

        hr {
            margin: 20px 0;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: #6c757d;
        }

        .alert-danger {
            background-color: #fee;
            border-left: 4px solid var(--color-brand-mts-red);
            border-radius: 8px;
            color: #d8400c;
            padding: 12px 16px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="mts-logo-large">
            <img src="https://static.mts.ru/mts_rf/images/logo-eco.svg" alt="МТС">
        </div>
        <h2>Система контроля ключей</h2>
        <div class="subtitle">ПАО «МТС»</div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        
        <form action="/login" method="post">
            <div class="mb-3">
                <label class="form-label">Логин</label>
                <input type="text" name="username" class="form-control" placeholder="Введите логин" required autofocus>
                <div class="form-text">Введите ваш корпоративный логин (например, ivanov_ia)</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Пароль</label>
                <input type="password" name="password" class="form-control" placeholder="Введите пароль">
                <div class="form-text">Любой пароль (для тестирования)</div>
            </div>
            <button type="submit" class="btn-login">Войти в систему</button>
        </form>
        
        <hr>
        <div class="footer-text">
            <i class="fas fa-shield-alt"></i> Отдел эксплуатации сетей
        </div>
    </div>
</body>
</html>